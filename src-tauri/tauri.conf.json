{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DH Studio Pro",
  "version": "2.7.0",
  "identifier": "com.minhvuong.devtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DH Studio Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright © 2026 DevHouse Software. All rights reserved.",
    "publisher": "DevHouse Software",
    "category": "Utility",
    "shortDescription": "DH Studio Pro by DevHouse Software",
    "longDescription": "DH Studio Pro is an all-in-one professional studio suite developed by DevHouse Software, featuring smart photo filtering, contact sheet generation, batch image conversion, and studio tools."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/minhvuogdzz/photo-picker-pro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3QzZDQ0U1NjNCM0U4OTIKUldTUzZMTmo1Y3pHSjJnY2JYTVR3QUVWZit3cFp4QWZhQ1BIbU1FT09kUkZzcnd0Z1paREZYNm4K"
    }
  }
}
